# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transaction_ledger?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# Idempotency
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_STALE_THRESHOLD_MS=60000

# Database connection pool
DB_POOL_SIZE=20
