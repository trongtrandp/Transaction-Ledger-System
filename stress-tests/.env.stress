# Stress test environment
PORT=3000
NODE_ENV=production

# Stress PostgreSQL (port 5433, tmpfs)
DATABASE_URL="postgresql://stress:stress@localhost:5433/stress_ledger?schema=public"

# Stress Redis (port 6380, no persistence)
REDIS_HOST=localhost
REDIS_PORT=6380

# Disable throttle for stress tests
THROTTLE_TTL=60000
THROTTLE_LIMIT=999999

# Short idempotency TTL for stress
IDEMPOTENCY_TTL_HOURS=1

# Connection pool — keep well below max_connections (300) to leave headroom for migrations, monitoring, and multiple instances
DB_POOL_SIZE=50
