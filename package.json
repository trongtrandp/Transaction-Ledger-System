{
  "name": "transaction-ledger-system",
  "version": "0.0.1",
  "description": "Transaction Ledger System - Immutable ledger with PostgreSQL and Redis",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:cluster": "node dist/src/cluster",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "stress:infra:up": "docker compose -f stress-tests/docker-compose.stress.yml up -d --wait",
    "stress:infra:down": "docker compose -f stress-tests/docker-compose.stress.yml down -v",
    "stress:db:setup": "dotenv -e stress-tests/.env.stress -- npx prisma migrate deploy",
    "stress:app:start": "dotenv -e stress-tests/.env.stress -- node dist/src/main",
    "stress:smoke": "bash stress-tests/run.sh smoke",
    "stress:load": "bash stress-tests/run.sh load",
    "stress:stress": "bash stress-tests/run.sh stress",
    "stress:spike": "bash stress-tests/run.sh spike",
    "stress:idempotency": "bash stress-tests/run.sh idempotency",
    "stress:throttle": "bash stress-tests/run.sh throttle",
    "stress:write-only": "bash stress-tests/run.sh write-only",
    "stress:mixed": "bash stress-tests/run.sh mixed-load"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.16",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.16",
    "@nestjs/platform-express": "11.1.16",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "7.4.2",
    "bullmq": "5.70.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^17.3.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.0",
    "joi": "18.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.16",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.3.5",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "prisma": "7.4.2",
    "source-map-support": "0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
